# =============================================================================
# LLM API Configuration
# =============================================================================
# CurricuLLM is prioritized for script generators (OpenAI-compliant API)
# Set CURRICULLM_API_KEY to use CurricuLLM, or OPENAI_API_KEY as fallback

# CurricuLLM API (Prioritized for script generation)
CURRICULLM_API_KEY=your_curricullm_api_key_here
CURRICULLM_API_URL=https://api.curricullm.com
CURRICULLM_MODEL=

# OpenAI API (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scriptfoundary

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

# =============================================================================
# Vector Store Configuration
# =============================================================================
# Pinecone (Optional - if not set, uses FAISS locally)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# FAISS (Default)
USE_FAISS=true
FAISS_INDEX_PATH=./data/faiss_index

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_CURRICULUM_ALIGNER=true
ENABLE_MISCONCEPTION_CHECKER=true
ENABLE_SCRIPT_GENERATOR=true
ENABLE_FACT_CHECKER=true
ENABLE_CULTURAL_SAFETY=true
ENABLE_ACCESSIBILITY=true
