# API Keys
# At least one LLM API key is required (OpenAI or Anthropic)
OPENAI_API_KEY=your_openai_api_key_here
# OR
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CurricuLLM-AU API (optional - will use mock data if not provided)
CURRICULLM_API_KEY=your_curricullm_api_key_here
CURRICULLM_API_URL=https://api.curricullm.com

# Database (Supabase or local PostgreSQL)
# For Docker: postgresql://postgres:postgres@postgres:5432/scriptfoundary
# For local: postgresql://postgres:postgres@localhost:5432/scriptfoundary
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scriptfoundary

# Redis (optional, for caching)
# For Docker: redis://redis:6379/0
# For local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Vector Store Configuration
# Option 1: Use FAISS (local, default)
USE_FAISS=true
FAISS_INDEX_PATH=./data/faiss_index

# Option 2: Use Pinecone (uncomment and configure)
# USE_FAISS=false
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment
# PINECONE_INDEX_NAME=script-foundary

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature Flags (enable/disable modules)
# Set to false to disable any module
ENABLE_CURRICULUM_ALIGNER=true
ENABLE_MISCONCEPTION_CHECKER=true
ENABLE_SCRIPT_GENERATOR=true
ENABLE_FACT_CHECKER=true
ENABLE_CULTURAL_SAFETY=true
ENABLE_ACCESSIBILITY=true

# LLM Model Settings
OPENAI_MODEL=gpt-4
ANTHROPIC_MODEL=claude-3-sonnet-20240229
